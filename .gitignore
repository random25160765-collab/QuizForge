# ---------------------------------------------------------------- 密钥
# 含 AI 密钥的本地配置，绝不入库
config/ai.local.json
# docker compose 会自动读取仓库根的 .env 做变量替换，
# 所以 AI 密钥与环境变量都放这里（用 make env-init 生成）
/.env
api/.env

# ---------------------------------------------------------------- Python
api/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# ---------------------------------------------------------------- 构建产物
# 前端产物。本地由 make web 生成；镜像里由 Dockerfile 的多阶段构建生成，
# 不依赖这个目录进版本库
api/web/
# 用户上传的附件：只在本机，绝不进版本库（内容是别人的文档，还可能有个人信息）
api/var/

# ------------------------------------------------------------ 运行期数据
*.db
*.sqlite3

# -------------------------------------------------------- 外部参考资料（只读）
# reference/ 是指向 /mnt/f/Documents 的软链：手册、论文、教科书，几百 MB 级，
# 绝不入库。材料只读，进 git 的只能是题目。
/reference

# ------------------------------------------------------------------ 编辑器
.DS_Store
.idea/
.vscode/
*.swp

# 流水线的运行日志与缓存（2026-09-16）
pipeline/*.log
pipeline/*.out
pipeline/state.sqlite3*
__pycache__/
*.pyc

# 浏览器自测的产物（2026-09-17）
# playwright-cli 把控制台日志与页面快照写在**当前工作目录**，在仓库根跑一次就到这里。
# 它们是可重建的临时物，不该进版本库，也不该在 git status 里刷存在感。
/.playwright-cli/

# 流水线中间产物：知识空间已在数据库里，这些随时可重跑（2026-09-16）
maps/**/extract/
maps/**/figures/
maps/**/*.verify.json
maps/**/pack-*.json
maps/_attic/

# 题库物化的临时目录（权威在数据库，用完即删）
.bank-cache/
