# 复制成 api/.env 后填写。该文件**不要提交**（已在 .gitignore 里）。

QF_DEBUG=true

# ---------------------------------------------------------------- 数据
# 想换数据库位置就取消注释并改路径（默认 = <仓库根>/data/quizforge.db）
# QF_DATABASE_URL=sqlite:////绝对路径/quizforge.db
# QF_DATA_DIR=/绝对路径/data

# ---------------------------------------------------------------- AI
# 密钥不在这里 —— 每台机器自己的那份在 config/settings.local.json 的 `ai` 块
QF_AI_ENABLED=true
QF_AI_TIMEOUT_MS=90000
# 每用户每日批改上限，0 = 不限
QF_AI_DAILY_QUOTA=0

# ------------------------------------------------------------ 开发态
# 前端跑在别的端口时才需要
# QF_CORS_ORIGINS=http://127.0.0.1:5173
