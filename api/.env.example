# 复制成 api/.env 后填写。该文件**不要提交**（已在 .gitignore 里）。
#
# 生成会话签名密钥：
#   python3 -c 'import secrets;print(secrets.token_urlsafe(48))'

QF_DEBUG=true

# ---------------------------------------------------------------- 数据
QF_DATABASE_URL=postgresql+psycopg://quizforge:quizforge@127.0.0.1:5432/quizforge

# ---------------------------------------------------------------- 会话
QF_SECRET_KEY=
# 部署在 HTTPS 后面时置 true
QF_COOKIE_SECURE=false
QF_SESSION_TTL_DAYS=30

# ---------------------------------------------------------------- AI
# 密钥只留在服务端；前端只能通过 /api/ai/* 间接使用
QF_AI_ENABLED=true
QF_AI_BASE_URL=https://api.deepseek.com/v1
QF_AI_MODEL=deepseek-chat
QF_AI_API_KEY=
QF_AI_TIMEOUT_MS=90000
# 每用户每日批改上限，0 = 不限
QF_AI_DAILY_QUOTA=0

# ------------------------------------------------------------ 开发态
# 前端跑在别的端口时才需要
# QF_CORS_ORIGINS=http://127.0.0.1:5173
