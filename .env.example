# quizforge 部署环境变量
#
#     cp .env.example .env      # 或 make env-init
#
# docker compose 会自动读取**同目录**的 .env 做变量替换，所以
# `docker compose up -d` 就带上这些值 —— 不必每次 export，
# 换机器或重建容器也不会丢。
#
# .env 已被 .gitignore 忽略，不会进版本库。

# ---------------------------------------------------------------- AI 批改
# 这里**没有任何密钥**。
#
# AI 密钥由**每个用户在自己的设置面板里填**（「设置 → AI 批改」），
# 存在各自的账号里，换设备不用重填。服务端只在转发请求时用一下，
# 不为任何人提供共享密钥 —— 谁的额度谁负责。
#
# 服务端只留两个策略开关：

# 实例级总开关。设成 false 后所有人都用不了 AI 批改（运维用）
QF_AI_ENABLED=true

# **每人**每日调用上限，0 表示不限。
# 留空/0 是不限：自己的密钥自己心疼，不需要站长为用量设闸。
QF_AI_DAILY_QUOTA=0

# 超时上限（毫秒）。用户在设置里填的超时不能超过它。
QF_AI_TIMEOUT_MS=90000

# ---------------------------------------------------------------- 部署
# 绑定的宿主端口（容器内固定 8000）
API_PORT=8100

# 上了 HTTPS 之后改成 true，Cookie 就只走加密连接
QF_COOKIE_SECURE=false
