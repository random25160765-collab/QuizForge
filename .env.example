# quizforge 部署环境变量
#
#     cp .env.example .env      # 或 make env-init
#
# docker compose 会自动读取**同目录**的 .env 做变量替换，所以
# `docker compose up -d` 就带上这些值 —— 不必每次 export，
# 换机器或重建容器也不会丢。
#
# .env 已被 .gitignore 忽略，不会进版本库。

# ---------------------------------------------------------------- AI 批改
# 这里**没有任何密钥**。
#
# AI 密钥由**每个用户在自己的设置面板里填**（「设置 → AI 批改」），
# 存在各自的账号里，换设备不用重填。服务端只在转发请求时用一下，
# 不为任何人提供共享密钥 —— 谁的额度谁负责。
#
# 服务端只留两个策略开关：

# 实例级总开关。设成 false 后所有人都用不了 AI 批改（运维用）
QF_AI_ENABLED=true

# **每人**每日调用上限，0 表示不限。
# 留空/0 是不限：自己的密钥自己心疼，不需要站长为用量设闸。
QF_AI_DAILY_QUOTA=0

# 超时上限（毫秒）。用户在设置里填的超时不能超过它。
QF_AI_TIMEOUT_MS=90000

# 对话的上下文预算上限（token）。用户可以在设置里调得更小，不能更大。
QF_AI_MAX_CONTEXT_TOKENS=8000

# ------------------------------------------------------------- 内测通道
#
# 内测期间让「没有自带密钥的人也能聊」：站长拿自己的一份额度请大家试用。
# 通道的配置放在一个**被 gitignore 的文件**里（与用户设置里的 ai 同形）：
#
#     config/ai.local.json
#     { "enabled": true, "baseUrl": "https://api.deepseek.com/v1",
#       "model": "deepseek-chat", "apiKey": "sk-…" }
#
# **密钥只在那份文件里**，不写进 .env、也不进服务端配置对象（那个会被打印）。
#
# 优先级：用户自己的密钥 > 内测通道 > 明确报错（不静默降级）。
# 通道仍受上面的 QF_AI_ENABLED 与 QF_AI_DAILY_QUOTA 约束 ——
# 它用的是**共享密钥**，所以强烈建议把 QF_AI_DAILY_QUOTA 设成非 0。
QF_AI_BETA_ENABLED=true
# 想换一份配置（比如另起一个测试用的密钥文件）就改这个路径
QF_AI_BETA_CONFIG_FILE=config/ai.local.json

# ---------------------------------------------------------------- 部署
# 绑定的宿主端口（容器内固定 8000）
API_PORT=8100

# 上了 HTTPS 之后改成 true，Cookie 就只走加密连接
QF_COOKIE_SECURE=false
