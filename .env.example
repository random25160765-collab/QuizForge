# quizforge 环境变量
#
#     cp .env.example .env      # 或 make env-init
#
# 本机跑服务时读它；`docker compose` 也读**同目录**这一份（那个容器现在只用
# 来搬历史数据，见 docker-compose.yml）。.env 已被 .gitignore 忽略，不进版本库。

# ---------------------------------------------------------------- AI 批改
# 这里**没有任何密钥**。
#
# AI 密钥放在本机自己的那一份配置文件里：
#
#     config/ai.local.json
#
# （同样被 gitignore）。服务端只在转发请求时用一下，它自己不持有第二个密钥。
#
# 服务端只留几个策略开关：

# 总开关。设成 false 后 AI 批改与对话全部关掉（只读界面照常）。
QF_AI_ENABLED=true

# 每日调用上限，0 表示不限。自己的密钥自己心疼，默认不设闸。
QF_AI_DAILY_QUOTA=0

# 超时上限（毫秒）。设置里填的超时不能超过它。
QF_AI_TIMEOUT_MS=90000

# 对话的上下文预算上限（token）。设置里可以调得更小，不能更大。
QF_AI_MAX_CONTEXT_TOKENS=8000

# ------------------------------------------------------------- 内测通道
#
# 让「没自带密钥也能聊」的那条通道：拿一份共享密钥顶一下，试用与自测用。
# 配置就在上面那个被 gitignore 的文件里（与设置里的 ai 同形）：
#
#     config/ai.local.json
#     { "enabled": true, "baseUrl": "https://api.deepseek.com/v1",
#       "model": "deepseek-flash", "apiKey": "sk-…" }
#
# **密钥只在那份文件里**，不写进 .env、也不进服务端配置对象（那个会被打印）。
#
# 优先级：自己填的密钥 > 内测通道 > 明确报错（不静默降级）。
# 通道仍受上面的 QF_AI_ENABLED 与 QF_AI_DAILY_QUOTA 约束 ——
# 它用的是共享密钥，所以建议把 QF_AI_DAILY_QUOTA 设成非 0。
QF_AI_BETA_ENABLED=true
# 想换一份配置（比如另起一个测试用的密钥文件）就改这个路径
QF_AI_BETA_CONFIG_FILE=config/ai.local.json

# ---------------------------------------------------------------- 服务
# 绑定的宿主端口（本机 uvicorn 直接用它）
API_PORT=8100

# 只在把服务放到 HTTPS 后面时才需要改成 true
QF_COOKIE_SECURE=false
